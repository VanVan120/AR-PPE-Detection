# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ── Secrets — never commit real keys ─────────────────────────────────────────
.env
.env.local

# ── Model weights (large; train via the notebooks or attach to a Release) ────
*.pt
*.onnx

# ── Datasets (large; download from Roboflow — see README) ────────────────────
# Anchored to repo root so phase2/data/clips/ (small demo assets) is NOT ignored.
/data/

# ── Generated / runtime outputs (any level: outputs/, phase2/outputs/) ───────
outputs/
runs/

# ── Demo / session media (regenerable; derived from the CC BY 4.0 dataset) ───
*.mp4
*.avi

# ── Phase 3 (Assembly101) — gated CC BY-NC 4.0 data, features & checkpoints ──
# TSM feature LMDBs (~34 GB/view), coarse annotations, statistic_input.pkl, models.
phase3_activity/data/
# Ignore the CONTENTS, not the directory itself, so the two small learned workflow
# models below can be re-included (git cannot re-include a file whose parent dir is
# excluded). The TAS checkpoint stays out — it is useless without the 34 GB features.
phase3_activity/models/*
!phase3_activity/models/procedure_model.json
!phase3_activity/models/anticipation_model.json
!phase3_activity/models/NOTICE.md

# ── Phase 4 — exported models + measurement JSON (regenerate with the CLIs) ──
phase4_deploy/artifacts/
*.torchscript

# ── OS cruft ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
